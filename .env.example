# Copy this file to .env and fill in real values. Never commit the real .env file.

# Google AI Studio API key (Gemini Flash + embeddings, free tier)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://flyrank:flyrank_dev_pw@localhost:5432/flyrank